# Generate the real ignored file with: python3 scripts/configure_server.py --origin https://demo.example.com
ASTRA_ALLOWED_ORIGIN=https://demo.example.com
ASTRA_SITE_ADDRESS=demo.example.com
ASTRA_HTTP_PORT=80
ASTRA_HTTPS_PORT=443
# Generated by configure_server.py; never put this secret in frontend configuration.
ASTRA_DEMO_TOKEN=
