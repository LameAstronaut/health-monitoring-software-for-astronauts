# Copy to .env in the root; backend loads this file. Demo configuration only.
ASTRA_MODE=DEMO
ASTRA_DATABASE_URL=sqlite:///./astra.db
ASTRA_DEMO_TOKEN=local-demo-only
ASTRA_ALLOWED_ORIGIN=http://127.0.0.1:5173
ASTRA_STALE_SECONDS=5
ASTRA_DISCONNECT_SECONDS=15
# Simulator reads ASTRA_DEMO_TOKEN from the shell (or uses local-demo-only).
# make dev shares the backend's .env configuration with the simulator automatically.
# Optional Vite server-only override; never put the demo token in VITE_* variables.
ASTRA_API_PROXY_TARGET=http://127.0.0.1:8000
